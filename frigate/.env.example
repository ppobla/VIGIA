# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o Git.
# Só variáveis começando com FRIGATE_ podem ser usadas no config.yml.

# Casa A — DVR (Intelbras/Dahua)
FRIGATE_CASA_A_DVR_IP=192.168.1.100
FRIGATE_CASA_A_DVR_USER=admin
FRIGATE_CASA_A_DVR_PASS=troque-me

# Casa A — câmera IP 01 (Hikvision)
FRIGATE_CASA_A_IPCAM01_IP=192.168.1.101
FRIGATE_CASA_A_IPCAM01_USER=admin
FRIGATE_CASA_A_IPCAM01_PASS=troque-me

# Casa B — DVR (IP da rede local da Casa B, alcançado pela ponte Tailscale)
FRIGATE_CASA_B_DVR_IP=192.168.0.100
FRIGATE_CASA_B_DVR_USER=admin
FRIGATE_CASA_B_DVR_PASS=troque-me
